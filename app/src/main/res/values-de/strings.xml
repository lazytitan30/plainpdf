    <string name="tour_welcome_title">Plain PDF</string>
    <string name="tour_welcome_body">Vielen Dank fürs Installieren. PDFs lesen, unterschreiben, scannen und bearbeiten, alles auf Ihrem Telefon. Keine Werbung, kein Konto, keine Cloud.</string>
