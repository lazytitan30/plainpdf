    <!-- Supporter -->
    <string name="supporter_title">Người ủng hộ</string>
    <string name="supporter_intro">Plain PDF miễn phí và không có quảng cáo, mọi tính năng đều dùng được mà không cần trả tiền. Nếu ứng dụng giúp ích cho bạn, đây là nơi để nói lời cảm ơn. Đổi lại bạn nhận được vài màu sắc và biểu tượng, cùng lòng biết ơn của chúng tôi.</string>
    <string name="supporter_grants_title">Bạn nhận được gì</string>
    <string name="supporter_grant_accents">Sáu màu nhấn</string>
    <string name="supporter_grant_icons">Ba biểu tượng ứng dụng khác</string>
    <string name="supporter_grant_highlights">Thêm các bộ màu tô sáng</string>
    <string name="supporter_grant_about">Một dòng Người ủng hộ trong phần Giới thiệu</string>
    <string name="supporter_unlock">Trở thành Người ủng hộ</string>
    <string name="supporter_tips_title">Ủng hộ thêm</string>
    <string name="supporter_tips_summary">Không bắt buộc. Nếu sau này bạn muốn ủng hộ thêm, đây là nơi dành cho việc đó. Không mở khóa gì mới; chỉ đơn giản là nói lời cảm ơn.</string>
    <string name="supporter_restore">Khôi phục giao dịch mua</string>
    <string name="supporter_restore_found">Giao dịch mua của bạn đã trở lại. Cảm ơn bạn.</string>
    <string name="supporter_restore_none">Không tìm thấy gói Người ủng hộ cho tài khoản Google này. Quà tặng không để lại ghi nhận nào, nên không thể khôi phục.</string>
    <string name="supporter_unavailable">Google Play hiện không thể nhận thanh toán trên điện thoại này. Không mất gì cả; ứng dụng vẫn miễn phí.</string>
    <string name="supporter_thanks">Bạn là Người ủng hộ. Cảm ơn bạn đã giúp Plain PDF luôn miễn phí.</string>
    <string name="supporter_donate_intro">Plain PDF miễn phí và không có quảng cáo, mọi tính năng đều dùng được mà không cần trả tiền. Nếu ứng dụng giúp ích cho bạn, bạn có thể ủng hộ công sức đằng sau nó.</string>
    <string name="supporter_donate_button">Mở trang ủng hộ</string>
    <string name="supporter_grant_future">Màu sắc và biểu tượng mới được thêm sau này, không tốn thêm phí</string>
    <string name="supporter_tips_title_first">Hoặc gửi một khoản ủng hộ</string>
    <string name="supporter_tips_summary_first">Số tiền nào cũng là một lời cảm ơn.</string>
    <string name="supporter_tip_unlocks_note">Cũng mở khóa gói Người ủng hộ</string>
    <string name="supporter_gift_title">Cảm ơn món quà của bạn</string>
    <string name="supporter_gift_body">Bạn đã gửi một khoản ủng hộ, và gói Người ủng hộ cũng là của bạn: mọi màu sắc, biểu tượng và bộ màu đánh dấu đều đã mở khóa. Không cần mua gói này nữa.</string>
    <string name="supporter_gift_note">Quà tặng không để lại ghi nhận nào trên Google Play, nên gói này được ghi nhớ trên điện thoại này.</string>
    <string name="supporter_snack_gift">Cảm ơn món quà của bạn.</string>
    <string name="supporter_snack_unlock">Cảm ơn bạn. Giờ bạn là Người ủng hộ.</string>
    <string name="supporter_problem_connection">Google Play không phản hồi. Hãy kiểm tra xem ứng dụng Cửa hàng Play đã đăng nhập chưa, rồi quay lại. Không mất gì cả; ứng dụng vẫn miễn phí.</string>
    <string name="supporter_problem_listing">Google Play chưa niêm yết các mục Người ủng hộ. Vui lòng thử lại sau. Không mất gì cả; ứng dụng vẫn miễn phí.</string>
    <string name="supporter_problem_region">Google Play chưa cung cấp các mục này ở quốc gia của bạn. Không mất gì cả; ứng dụng vẫn miễn phí.</string>

