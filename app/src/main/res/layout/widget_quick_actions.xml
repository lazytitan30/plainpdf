<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/widget_scan"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1.2"
        android:layout_marginEnd="6dp"
        android:background="@drawable/widget_button_primary"
        android:drawableStart="@drawable/ic_widget_scan"
        android:drawablePadding="6dp"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/widget_scan_short"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_open"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:layout_marginEnd="6dp"
        android:background="@drawable/widget_button_secondary"
        android:drawableStart="@drawable/ic_widget_open"
        android:drawablePadding="6dp"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/widget_open"
        android:textColor="#1B1B1B"
        android:textSize="14sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_library"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:background="@drawable/widget_button_secondary"
        android:drawableStart="@drawable/ic_widget_library"
        android:drawablePadding="6dp"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/widget_library"
        android:textColor="#1B1B1B"
        android:textSize="14sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
